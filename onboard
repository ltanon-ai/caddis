#!/usr/bin/env bash
# onboard — install the conscience and PROVE it is alive.
# An install that cannot show you a denial is not an install.
set -u
if [ -z "${HOME:-}" ]; then HOME="$USERPROFILE"; fi
# WHERE AM I. `$0` is the SOURCING script when this file is sourced, and the
# GitHub matrix sources it (`. ./onboard`), so every "$(dirname "$0")/..." path
# pointed outside the repository there: the skill install looked for a helper
# that was not there, failed, and — before the install grew a check — said
# nothing. ${BASH_SOURCE[0]} names THIS file under both invocations.
SELF="${BASH_SOURCE[0]:-$0}"
HERE="$(cd -- "$(dirname -- "$SELF")" && pwd)"
HARNESS="${1:-}"
BIN_DIR="$HOME/.caddis/bin"
EXE="$BIN_DIR/caddis-warden.exe"
[ -x "$BIN_DIR/caddis-warden" ] && EXE="$BIN_DIR/caddis-warden"
LEDGER="${CADDIS_WARDEN_LEDGER:-$HOME/.caddis/warden-ledger.jsonl}"

die() { echo "onboard: FAIL — $1" >&2; exit 1; }

# 1. Build and install the binary (the INSTALLED copy, never target/release).
command -v cargo >/dev/null || die "cargo not found on PATH"
cargo build --release || die "cargo build --release failed"
mkdir -p "$BIN_DIR" || die "cannot create $BIN_DIR"
if [ -f target/release/caddis-warden.exe ]; then
    cp target/release/caddis-warden.exe "$EXE" || die "install failed"
else
    cp target/release/caddis-warden "$EXE" || die "install failed"
fi
echo "onboard: binary installed at $EXE"

# 2. The self-proof, frame-level: force-push must DENY, echo must ALLOW.
frame() {
    local tool="$1" command="$2"
    printf 'tool %d\n%s\n' "${#tool}" "$tool"
    printf 'command %d\n%s\n' "${#command}" "$command"
    printf 'path 0\n\ncontent 0\n\n'
}

deny_reply=$(frame bash "git push --force origin main" | "$EXE")
echo "$deny_reply" | grep -q '"verdict":"deny"' \
    || die "force-push was not denied — the conscience came up mute. Reply: $deny_reply"

allow_reply=$(frame bash "echo onboard-self-proof" | "$EXE")
echo "$allow_reply" | grep -q '"verdict":"allow"' \
    || die "an innocuous echo was not allowed — the law is over-firing. Reply: $allow_reply"

seq=$(echo "$deny_reply" | sed -n 's/.*"seq":\([0-9]*\).*/\1/p')
[ -n "$seq" ] && [ "$seq" != "0" ] \
    || die "verdicts returned but no ledger row was written (seq=0)"
# The deny row is found by CONTENT in the tail, never by line number:
# line-N == seq-N held only while every row was one physical line.
row=$(tail -5 "$LEDGER" 2>/dev/null | grep '"body":"deny|git push --force origin main' | tail -1)
[ -n "$row" ] || die "the denial is not in the ledger tail: $(tail -2 "$LEDGER")"

# The agent's helper: install the caddis skill so the AGENT knows the
# system too (users memorize nothing). Claude Code reads
# ~/.claude/skills; the agentskills.io standard dir ~/.agents/skills is
# read by extension-based harnesses.
# The install is IDEMPOTENT and lives in its own script, because `cp -r` into an
# existing directory nests instead of replacing — and this runs a second time on
# every update, which is the path a one-shot self-proof can never exercise.
SRC_SKILL="$HERE/skills/caddis"
bash "$HERE/tools/install-skill.sh" "$SRC_SKILL" \
    "$HOME/.claude/skills/caddis" "$HOME/.agents/skills/caddis" \
    || die "the agent helper did not install anywhere (see the warnings above)"

echo "onboard: PROOF — force-push DENIED (ledger seq $seq), echo ALLOWED."
echo "onboard: the conscience is live. Next: wire your harness (ONBOARD.md step 2)" \
     "as '${HARNESS:-<harness>}' if you want in-ledger attribution."

# If a harness was named, stamp the local adapter copy's CALLER constant.
if [ -n "$HARNESS" ] && [ -f "$HERE/adapters/caddis-warden.ts" ]; then
    src="$HERE/adapters/caddis-warden.ts"
    case "$HARNESS" in
      little-coder) dest="$HOME/.config/little-coder/extensions/caddis-warden.ts" ;;
      prime-agent)   dest="$HOME/.prime/agent/extensions/caddis-warden.ts" ;;
      omp)           dest="$HOME/.omp/agent/extensions/caddis-warden.ts" ;;
      *)             dest="" ;;
    esac
    if [ -n "$dest" ]; then
        mkdir -p "$(dirname "$dest")"
        # Two line shapes exist: env-stamp-aware (current) and the plain
        # constant (older copies). Exactly one can match; the stamp sets the
        # DEFAULT label — a launcher may still override it via CADDIS_WARDEN_FROM.
        sed -e "s/const CALLER = process\.env\.CADDIS_WARDEN_FROM || \"[a-z-]*\";/const CALLER = process.env.CADDIS_WARDEN_FROM || \"$HARNESS\";/" \
            -e "s/const CALLER = \"[a-z-]*\";/const CALLER = \"$HARNESS\";/" "$src" > "$dest" \
            && grep -q "const CALLER = [^\"]*\"$HARNESS\";" "$dest" \
            && echo "onboard: adapter stamped '$HARNESS' -> $dest" \
            || echo "onboard: WARNING — stamp pattern not found in $src; copied unstamped"
    fi
fi
