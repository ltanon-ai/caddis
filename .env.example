# caddis — environment variables the adapters and binary read.
# Copy to your shell profile or harness environment as needed.

# Where the warden binary lives (default: ~/.caddis/bin/caddis-warden[.exe])
CADDIS_WARDEN_BIN=

# Where the append-only verdict ledger is written
# (default: ~/.caddis/warden-ledger.jsonl)
CADDIS_WARDEN_LEDGER=

# The caller's name stamped into every ledger row's `from:` field
# (sanitized to [A-Za-z0-9._-], 32 bytes max; empty falls back to the default)
CADDIS_WARDEN_FROM=

# Claude Code adapter only: "1" makes sessions under no mapped cwd prefix
# stand aside silently (no judgement, no ledger row) instead of being stamped
# the generic label — a deliberate act for fleets wiring only some directories
CADDIS_WARDEN_STAND_ASIDE=
